{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "base",
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "ENABLE_VULKAN": "ON",
                "ENABLE_METAL": "OFF"
            }
        },
        {
            "name": "linux-release",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-debug",
            "inherits": "linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "macos",
            "hidden": true,
            "inherits": "base",
            "generator": "Ninja",
            "cacheVariables": {
                "ENABLE_METAL": "ON",
                "ENABLE_VULKAN": "OFF"
            }
        },
        {
            "name": "macos-release",
            "inherits": "macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "macos-debug",
            "inherits": "macos",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "cacheVariables": {
                "ENABLE_VULKAN": "ON",
                "ENABLE_METAL": "OFF"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "linux-release",
            "configurePreset": "linux-release",
            "jobs": 0
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug",
            "jobs": 0
        },
        {
            "name": "macos-release",
            "configurePreset": "macos-release",
            "jobs": 0
        },
        {
            "name": "macos-debug",
            "configurePreset": "macos-debug",
            "jobs": 0
        },
        {
            "name": "windows-release",
            "configurePreset": "windows",
            "configuration": "Release"
        },
        {
            "name": "windows-debug",
            "configurePreset": "windows",
            "configuration": "Debug"
        }
    ]
}
