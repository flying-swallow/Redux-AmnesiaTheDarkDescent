#version 460

#extension GL_GOOGLE_include_directive                  : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_ray_tracing                            : require
#extension GL_EXT_ray_query                              : require
#extension GL_EXT_debug_printf                           : enable

#include "host_device.h"
#include "bindless.resource.glsl"   // surfels + cells + pointLights at set 0
#include "per_frame.resource.glsl"  // perFrame UBO at set 1 (totalFrames, pointLightCount)

#include "globals.glsl"             // PtPayload / Ray structs

#include "layouts.glsl"             // TLAS at set 2 binding 0
#include "random.glsl"
#include "common.glsl"
#include "compress.glsl"
#include "pathtrace.glsl"           // OffsetRayBindless helper
#define TRACERAY_RQ_HAS_PRD          // opt in to ClosestHit (needs PtPayload in scope)
#include "traceray_rq.glsl"         // ClosestHit / AnyHit
#include "shaderUtils_surfel_cell.glsl"
#include "shaderUtils.glsl"

// Surfel irradiance map — sampled by the ray-guiding branch when the surfel's
// 6x6 atlas is fully populated. Same view the integrate pass writes; host
// binds at GENERAL layout.
layout(set = 2, binding = 1) uniform sampler2D surfelIrradianceSampler;

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

void main()
{
    uint index = gl_GlobalInvocationID.x;

    // DIAGNOSTIC (remove once root cause for black irradiance is known):
    // thread-0, ~once-per-second, dump global counts so we can confirm the
    // raytrace dispatch is actually running with non-zero work and a
    // populated point-light SSBO.
    if (index == 0u && (totalFrames & 0x3Fu) == 0u)
    {
        debugPrintfEXT("[surfel_rt] f=%u alive=%u rayCnt=%u plc=%u\n",
                       totalFrames,
                       surfelCounter.aliveSurfelCnt,
                       surfelCounter.surfelRayCnt,
                       pointLightCount);
    }

    if (index >= surfelCounter.surfelRayCnt)
    {
        return;
    }

    SurfelRay surfelRay = surfelRayBuffer[index];
    uint frameHash = lowbias32(totalFrames);
    uint randSeed = tea(lowbias32(index), frameHash);
    uint surfelIndex = surfelRay.surfelID;
    bool isSleeping = (surfelRecycleInfo[surfelIndex].status & 0x0001u) != 0u;

    // Ray guiding — when the surfel's 6x6 octahedral atlas is fully populated
    // (LSB of surfel.irradiance set by integrate) and the surfel has enough
    // ray budget for the CDF to be meaningful (>16 rays/frame), sample a
    // direction proportional to atlas irradiance. Otherwise cosine-weighted.
    uint irradianceUint = surfelBuffer[surfelIndex].irradiance;
    float surfelIrradiance = uintBitsToFloat(irradianceUint);
    bool isFull = (irradianceUint & 0x01u) > 0u && surfelIrradiance > 1e-12;

    vec3 dirL;
    float pdf;

    if (isFull && (surfelBuffer[surfelIndex].rayCount > 16u))
    {
        ivec2 IrradianceMapRes = textureSize(surfelIrradianceSampler, 0);

        ivec2 irrMapBase = ivec2(
                surfelIndex % (IrradianceMapRes.x / 6),
                surfelIndex / (IrradianceMapRes.x / 6)
            );
        irrMapBase *= ivec2(6, 6);

        float threshold = rand(randSeed) * surfelIrradiance;
        float cummulative = 0.f;

        uvec2 rayCoord = uvec2(100);
        for (uint y = 0; y < 6; ++y)
        {
            for (uint x = 0; x < 6; ++x)
            {
                float irr = texelFetch(surfelIrradianceSampler, irrMapBase + ivec2(x, y), 0).r;
                cummulative += irr;
                if (cummulative >= threshold)
                {
                    rayCoord = uvec2(x, y);
                    pdf = irr / surfelIrradiance;
                    break;
                }
            }
            if (cummulative >= threshold) break;
        }

        vec2 uv = vec2(rayCoord - 3) / vec2(3.0);
        uv += rand2(randSeed) * 0.1f;
        dirL = OctUVToDir(uv);
    }
    else
    {
        // Cosine-weighted hemisphere fallback for newborns / undersampled surfels.
        vec2 uv = rand2(randSeed);
        dirL = CosineSampleHemisphere(uv.x, uv.y);
        pdf = dirL.z * M_1_OVER_PI;
    }

    vec3 N = decompress_unit_vec(surfelBuffer[surfelIndex].normal);

    vec3 T, B;
    CreateCoordinateSystem(N, T, B);
    vec3 dirW = normalize(dirL.x * T + dirL.y * B + dirL.z * N);

    Ray ray = Ray(surfelBuffer[surfelIndex].position, dirW);
    ray.origin += 0.05f * N;

    int maxDepth = isSleeping ? 5 : 3;
    // surfelPathTrace pulls its bounce RNG from prd.seed; seed it from
    // the per-ray random state we already built above.
    PtPayload prd;
    prd.seed = randSeed;
    surfelRay.radiance = surfelPathTrace(ray, maxDepth, surfelIndex, surfelRay.t, prd);
    float lum = dot(surfelRay.radiance, vec3(0.212671f, 0.715160f, 0.072169f));
    if (lum > fireflyClampThreshold)
    {
        surfelRay.radiance *= fireflyClampThreshold / lum;
    }
    // Radiance is physically non-negative; reject signed garbage from
    // surfelPathTrace before it can poison the MSME mean.
    surfelRay.radiance = max(surfelRay.radiance, vec3(0.0));
    surfelRay.dir_o = compress_unit_vec(dirL);
    surfelRay.pdf = pdf;

    surfelRayBuffer[index] = surfelRay;
}
