// Zero lightClustersCount[] for the 3D froxel grid each frame. The data
// buffer is not zeroed — stale entries past the current count are never
// read. Pull bindless.resource.glsl directly (the convenience header in
// light_cull_resources.glsl also drags in per_frame.resource.glsl, which
// this pass doesn't need).
#include "bindless.resource.glsl"

layout(local_size_x = LIGHT_CLUSTER_WIDTH,
       local_size_y = LIGHT_CLUSTER_HEIGHT,
       local_size_z = 1) in;

void main()
{
    const uvec3 tid = gl_GlobalInvocationID;
    if (tid.x >= LIGHT_CLUSTER_WIDTH ||
        tid.y >= LIGHT_CLUSTER_HEIGHT ||
        tid.z >= LIGHT_CLUSTER_SLICE)
    {
        return;
    }
    lightClustersCount[LIGHT_FROXEL_COUNT_POS(tid.x, tid.y, tid.z)] = 0u;
}
