// Build the 3D light-cluster grid for point lights.
//
// Dispatch shape: (pointLightCount, 1, LIGHT_CLUSTER_SLICE) workgroups,
// local size (LIGHT_CLUSTER_WIDTH, LIGHT_CLUSTER_HEIGHT, 1). One workgroup
// processes a single light against one Z slice; each thread tests one
// (x,y) tile within the slice. Lights survive an XY tile cull and a view-
// space sphere-vs-AABB test before being inserted into the per-froxel
// list. Port of AmnesiaTheDarkDescent's scene_light_cluster.comp.fsl
// stripped to point-only, rewritten against Amnesia64's bindless
// pointLights[] SSBO and per-frame UBO.
#include "globals.glsl"
#include "light_cull_resources.glsl"
#include "common.glsl"  // getDepthClipPlane / ndcToViewSpace /
                        // lineIntersectionToZPlane / testSphereAABB

layout(local_size_x = LIGHT_CLUSTER_WIDTH,
       local_size_y = LIGHT_CLUSTER_HEIGHT,
       local_size_z = 1) in;

void main()
{
    const uvec3 threadInGroupId = gl_LocalInvocationID;
    const uvec3 groupId         = gl_WorkGroupID;

    // Bail before any work for inactive light-slot workgroups. pointLightCount
    // is the upper bound on dispatch.x; the host may also pad to a wholesale
    // dispatch shape, so guard here.
    if (groupId.x >= pointLightCount) {
        return;
    }

    const float invClusterWidth  = 1.0 / float(LIGHT_CLUSTER_WIDTH);
    const float invClusterHeight = 1.0 / float(LIGHT_CLUSTER_HEIGHT);

    // Z slice in view space. The engine looks down -Z, so negate the
    // positive-distance helper output to land on the correct side.
    const float tileNear = -getDepthClipPlane(
        float(groupId.z),       float(LIGHT_CLUSTER_SLICE), zNear, zFar);
    const float tileFar  = -getDepthClipPlane(
        float(groupId.z) + 1.0, float(LIGHT_CLUSTER_SLICE), zNear, zFar);

    // Tile bounds in NDC. Vulkan clip-Y points down, so flip top/bottom so
    // (-1, -1) is the bottom-left of the tile.
    float clusterLeft   = float(threadInGroupId.x) * invClusterWidth;
    float clusterTop    = float(threadInGroupId.y) * invClusterHeight;
    float clusterRight  = clusterLeft + invClusterWidth;
    float clusterBottom = clusterTop  + invClusterHeight;

    clusterLeft   = clusterLeft   * 2.0 - 1.0;
    clusterTop    = clusterTop    * 2.0 - 1.0;
    clusterRight  = clusterRight  * 2.0 - 1.0;
    clusterBottom = clusterBottom * 2.0 - 1.0;

    clusterTop    *= -1.0;
    clusterBottom *= -1.0;

    // Two opposing NDC corners → two view-space rays from the camera origin.
    vec3 minPointViewSpace =
        ndcToViewSpace(vec4(clusterLeft,  clusterTop,    -1.0, 1.0), invProjMat);
    vec3 maxPointViewSpace =
        ndcToViewSpace(vec4(clusterRight, clusterBottom, -1.0, 1.0), invProjMat);

    // Slide each ray onto the slice's near/far plane → four corners per
    // plane; min/max gives the froxel AABB.
    vec3 viewSpaceNearP1 =
        lineIntersectionToZPlane(vec3(0.0), minPointViewSpace, tileNear);
    vec3 viewSpaceNearP2 =
        lineIntersectionToZPlane(vec3(0.0), maxPointViewSpace, tileNear);
    vec3 viewSpaceFarP1  =
        lineIntersectionToZPlane(vec3(0.0), minPointViewSpace, tileFar);
    vec3 viewSpaceFarP2  =
        lineIntersectionToZPlane(vec3(0.0), maxPointViewSpace, tileFar);

    vec3 minPointAABB = min(min(viewSpaceNearP1, viewSpaceNearP2),
                            min(viewSpaceFarP1,  viewSpaceFarP2));
    vec3 maxPointAABB = max(max(viewSpaceNearP1, viewSpaceNearP2),
                            max(viewSpaceFarP1,  viewSpaceFarP2));

    // Light → view-space sphere. The 1.2× radius padding matches the .fsl
    // reference; gives a small safety margin so falloff edges aren't culled
    // out from clusters their attenuation still touches.
    PointLight pl = pointLights[groupId.x];
    vec3  centerView = (viewMat * vec4(pl.position, 1.0)).xyz;
    float radius     = pl.radius * 1.2;

    if (!testSphereAABB(centerView, radius, minPointAABB, maxPointAABB)) {
        return;
    }

    const uint froxelIdx =
        LIGHT_FROXEL_COUNT_POS(threadInGroupId.x, threadInGroupId.y, groupId.z);
    const uint lightArrayPos = atomicAdd(lightClustersCount[froxelIdx], 1u);

    // Overflow drop. Matches the .fsl reference's silent-truncate behavior;
    // the count still increments so consumers can detect the saturation, but
    // we don't write past the per-froxel capacity into a neighbour's slot.
    // TODO: clamp the count back to MAX so consumers don't read garbage past
    // the saturated frontier.
    if (lightArrayPos >= LIGHT_CLUSTER_MAX_LIGHTS_PER_FROXEL) {
        return;
    }

    lightClusters[LIGHT_FROXEL_DATA_POS(threadInGroupId.x,
                                        threadInGroupId.y,
                                        groupId.z,
                                        lightArrayPos)] = groupId.x;
}
